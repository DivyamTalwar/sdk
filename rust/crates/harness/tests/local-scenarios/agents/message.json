{
  "driver": "agents",
  "prompt": "Send a followup to a settled worker",
  "models": {
    "parent": [
      [
        {
          "type": "event",
          "kind": "tool_call",
          "call_id": "spawn",
          "name": "agent",
          "arguments": {
            "command": "spawn",
            "reference": "worker",
            "prompt": "original work",
            "model": "worker"
          }
        },
        {
          "type": "event",
          "kind": "completed",
          "metadata": null
        }
      ],
      [
        {
          "type": "event",
          "kind": "tool_call",
          "call_id": "wait",
          "name": "agent",
          "arguments": {
            "command": "wait",
            "reference": "worker"
          }
        },
        {
          "type": "event",
          "kind": "completed",
          "metadata": null
        }
      ],
      [
        {
          "type": "event",
          "kind": "tool_call",
          "call_id": "send",
          "name": "agent",
          "arguments": {
            "command": "send",
            "reference": "worker",
            "message": "followup work"
          }
        },
        {
          "type": "event",
          "kind": "completed",
          "metadata": null
        }
      ],
      [
        {
          "type": "event",
          "kind": "tool_call",
          "call_id": "wait",
          "name": "agent",
          "arguments": {
            "command": "wait",
            "reference": "worker"
          }
        },
        {
          "type": "event",
          "kind": "completed",
          "metadata": null
        }
      ],
      "parent finished"
    ],
    "worker": [
      "first finished",
      "followup finished"
    ]
  },
  "expect": {
    "text": "parent finished",
    "requests": {
      "parent": 5,
      "worker": 2
    },
    "task_files": {
      "agents/worker/status.json": {
        "state": "Running",
        "settled": true,
        "inputs": 2
      }
    },
    "model_requests": {
      "worker": [
        {},
        {
          "messages": [
            {
              "role": "user",
              "content": {
                "$contains": "followup work"
              }
            }
          ]
        }
      ]
    }
  }
}
